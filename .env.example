# ==============================================================================
# GERENCIADOR DE FINANÇAS PESSOAIS - CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================
# Instruções rápidas:
# 1. Copie este arquivo para .env na raiz do projeto:
#    cp .env.example .env
# 2. Preencha suas credenciais gratuitas da Pluggy (instruções abaixo).
# 3. Inicie o sistema com: ./start.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CREDENCIAIS DA API PLUGGY (OPEN FINANCE BRASIL)
# ------------------------------------------------------------------------------
# Como obter gratuitamente:
# a) Acesse https://dashboard.pluggy.ai/ e crie sua conta de desenvolvedor.
# b) No painel, vá na seção de "API Keys" / "Credenciais".
# c) Copie o Client ID e Client Secret e cole abaixo:
PLUGGY_CLIENT_ID=seu_client_id_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_aqui

# Conexão da Conta Bancária:
# Você NÃO precisa preencher PLUGGY_ITEM_ID manualmente!
# Com as credenciais acima preenchidas e o app rodando, acesse:
# 👉 http://localhost:8000/connect
# O widget oficial abrirá para você conectar qualquer banco (Mercado Pago, Nubank, Itaú, etc.).
# O Item ID será salvo e sincronizado automaticamente no seu arquivo .env.
PLUGGY_ITEM_ID=
PLUGGY_ACCOUNT_IDS=

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS
# ------------------------------------------------------------------------------
# Por padrão, o sistema utiliza SQLite local (backend/finance.db) que é criado
# e estruturado automaticamente na primeira inicialização. Nenhuma configuração é necessária.
#
# Opcional (Caso queira rodar com PostgreSQL via Docker):
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=finance_db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_db

# ------------------------------------------------------------------------------
# 3. URL DA API DO BACKEND (FRONTEND NEXT.JS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
